# ==============================================
# KNIGHTBOT-MD AZIRYTECH ENVIRONMENT VARIABLES
# Copy this file to .env and configure your secrets
# ==============================================

# Server Port
PORT=3000

# Admin Panel Credentials (Change this before deploying!)
ADMIN_USER=admin
ADMIN_PASSWORD=ChangeThisToASecurePassword123!

# Bot Owner Configuration
BOT_NAME="Knight Bot"
BOT_OWNER="Azirytech"
OWNER_NUMBER=255XXXXXXXXX

# Support & Contact Details
SUPPORT_EMAIL=support@azirytech.com
SUPPORT_WA=255XXXXXXXXX
SUPPORT_TG=https://t.me/yourtelegram
SUPPORT_CHANNEL=https://whatsapp.com/channel/0029Va90zAnIHphOuO8Msp3A

# API Keys (Optional Third-Party Services)
GIPHY_API_KEY=your_giphy_api_key_here
XTEAM_API_KEY=your_xteam_key_here
LOLHUMAN_API_KEY=your_lolhuman_key_here

# Bot Operation Mode
COMMAND_MODE=public
MAX_SESSIONS=100
